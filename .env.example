# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/varmova_partner_portal?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Vercel production / preview
# On Vercel, NEXTAUTH_URL is usually not required explicitly for NextAuth.
# Add this only when needed outside Vercel or for custom setups.
# NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional: persistent file uploads on Vercel via Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Produktions-URL des Varmi Wirtschaftlichkeitsrechners ("varmi kalkulator").
# Wird in Academy, Sidebar und Dashboard verlinkt; ohne Wert zeigen die
# Oberflächen einen Hinweis statt eines toten Links.
NEXT_PUBLIC_CALCULATOR_URL=""

# Optional: OpenRouteService API key for address geocoding (FA-ANG-053).
# Without this key the wizard falls back to the deterministic Mock-Provider,
# which resolves addresses to approximate German city centers based on PLZ.
OPENROUTESERVICE_API_KEY=""

# Meta Lead Ads → Lead-CRM (/api/leads/meta)
# META_VERIFY_TOKEN: frei gewaehltes Geheimnis, dasselbe im Meta-Webhook-Setup eintragen.
# META_ACCESS_TOKEN: Page Access Token mit leads_retrieval + pages_show_list.
# META_APP_SECRET: App-Geheimcode; wenn gesetzt, wird die Webhook-Signatur geprueft (empfohlen).
META_VERIFY_TOKEN=""
META_ACCESS_TOKEN=""
META_APP_SECRET=""
