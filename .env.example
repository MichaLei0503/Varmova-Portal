# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/varmova_partner_portal?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Vercel production / preview
# On Vercel, NEXTAUTH_URL is usually not required explicitly for NextAuth.
# Add this only when needed outside Vercel or for custom setups.
# NEXTAUTH_URL="https://your-domain.vercel.app"

# Optional: persistent file uploads on Vercel via Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Produktions-URL des Varmi Wirtschaftlichkeitsrechners ("varmi kalkulator").
# Wird in Academy, Sidebar und Dashboard verlinkt; ohne Wert zeigen die
# Oberflächen einen Hinweis statt eines toten Links.
NEXT_PUBLIC_CALCULATOR_URL=""

# Optional: OpenRouteService API key for address geocoding (FA-ANG-053).
# Without this key the wizard falls back to the deterministic Mock-Provider,
# which resolves addresses to approximate German city centers based on PLZ.
OPENROUTESERVICE_API_KEY=""

# Meta Lead Ads → Lead-CRM (/api/leads/meta)
# META_VERIFY_TOKEN: frei gewaehltes Geheimnis, dasselbe im Meta-Webhook-Setup eintragen.
# META_ACCESS_TOKEN: Page Access Token mit leads_retrieval + pages_show_list.
# META_APP_SECRET: App-Geheimcode; wenn gesetzt, wird die Webhook-Signatur geprueft (empfohlen).
META_VERIFY_TOKEN=""
META_ACCESS_TOKEN=""
META_APP_SECRET=""

# E-Mail-Versand (Angebote an Kunden, Auftraege an Monteure).
# Ohne RESEND_API_KEY werden Mails nur ins Server-Log geschrieben (Mock).
RESEND_API_KEY=""
EMAIL_FROM="Varmova Portal <portal@varmova.de>"

# --- Lead-Funnel (FA-FUNNEL): /funnel, /api/leads/funnel, /api/leads/confirm ---
# Resend-API-Key für Double-Opt-in- und Willkommensmails (Domain varmova.de
# bei Resend verifizieren: SPF + DKIM). Ohne Key wird der Lead trotzdem
# gespeichert, es geht nur keine Mail raus.
RESEND_API_KEY=""
# Absender der Funnel-Mails (Domain muss bei Resend verifiziert sein).
LEAD_MAIL_FROM="Varmova <anfrage@varmova.de>"
# Secret für die Signatur der Bestätigungslinks (Fallback: NEXTAUTH_SECRET).
LEAD_DOI_SECRET=""
# Interne Benachrichtigung bei neuen Funnel-Leads.
# Default (ohne Wert): info@varmova.de — hier nur setzen, um zu überschreiben.
LEAD_NOTIFY_EMAIL=""
# Öffentliche Basis-URL für Links in Mails (Fallback: NEXTAUTH_URL, VERCEL_URL).
APP_BASE_URL=""

# Meta-Lead-Segmentierung (B2B/B2C im CRM).
# Optional: Formular-IDs kommagetrennt eindeutig zuordnen (empfohlen, sobald
# mehrere Kampagnen laufen). Ohne Zuordnung greift die inhaltliche Erkennung
# (Firma/Betriebstyp ausgefuellt -> B2B), danach META_DEFAULT_SEGMENT.
META_B2B_FORM_IDS=""
META_B2C_FORM_IDS=""
META_DEFAULT_SEGMENT="B2B"
